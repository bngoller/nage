{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo test --workspace)",
      "Bash(cargo clippy --workspace --all-targets -- -D warnings)",
      "Bash(cargo check --workspace --all-targets)",
      "Bash(cargo fmt --all --check)",
      "Bash(cargo deny check licenses)",
      "Bash(git commit:*)",
      "Bash(cargo sqlx:*)",
      "Bash(cargo xtask:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/rustfmt-after-edit.sh"
          }
        ]
      }
    ]
  }
}
