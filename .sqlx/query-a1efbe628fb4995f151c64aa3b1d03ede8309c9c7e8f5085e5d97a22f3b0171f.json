  "query": "SELECT DISTINCT t.id AS \"id!: i64\", a.id AS \"account_id!: AccountId\", t.created_at AS \"created_at!: Timestamp\", a.archived_at AS \"archived_at!: Timestamp\" FROM transactions t JOIN postings p ON p.transaction_id = t.id JOIN accounts a ON a.id = p.account_id WHERE a.archived_at IS NOT NULL AND t.created_at > a.archived_at ORDER BY t.id, a.id",
